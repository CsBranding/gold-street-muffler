{
  "title": "BLOCK WARS assets.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "assets": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "placeholder": {
            "type": "string"
          },
          "scale": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "url",
          "placeholder",
          "scale"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "assets"
  ],
  "additionalProperties": false
}
